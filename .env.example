# Exemplo de configuracao. Valores aqui sao FICTICIOS.
# Os valores reais NAO moram neste arquivo nem em lugar nenhum do repositorio:
# ficam no painel do Supabase, em Edge Functions > Secrets.

# Chave da Takeat, gerada em https://ai-builders.takeat.app
# Obrigatoria. Comeca com tk_test_ (teste) ou tk_live_ (producao).
TAKEAT_API_KEY=tk_test_000000000000000000000000

# Nome logico da credencial dentro do banco. Obrigatoria na pratica (tem padrao).
# Com uma unidade so, "pub_mogi" basta. Se um dia houver mais de uma chave,
# cada uma ganha o seu nome e os tokens ficam isolados por credencial.
TAKEAT_CREDENTIAL_KEY=pub_mogi

# Opcionais -- so mexer se houver motivo.
# Base da API. Padrao: https://public-api.takeat.app
TAKEAT_BASE_URL=https://public-api.takeat.app
# Intervalo minimo entre chamadas, em milissegundos. Padrao 6500 (teto de 10/min).
TAKEAT_MIN_INTERVAL_MS=6500
# Timeout de cada chamada, em milissegundos. Padrao 20000.
TAKEAT_TIMEOUT_MS=20000

# Injetadas automaticamente pelo Supabase nas Edge Functions.
# Nao precisam ser cadastradas a mao.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
